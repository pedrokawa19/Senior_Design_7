# Copy to ".env" on the internal server and fill in the real values.
# Real environment variables override anything set here.
# Never commit the filled-in .env -- it holds the keys to the saved credentials.

# Generate once with:
#   python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Must be false on the server. Debug pages leak settings and stack traces to
# anyone who can reach the site.
DJANGO_DEBUG=false

# The internal address people type in the browser, comma separated.
DJANGO_ALLOWED_HOSTS=10.0.0.10,vision-dashboard.local

# Needed for form posts. Use the same address with its scheme and port.
DJANGO_CSRF_TRUSTED_ORIGINS=http://10.0.0.10:8000,http://vision-dashboard.local:8000

# Leave false while the site is served over plain HTTP on the VPN.
# Set to true only after HTTPS is in front of it, or logins will stop working.
DJANGO_SECURE_COOKIES=false

# How long a signed-in session lasts before it needs another login.
DJANGO_SESSION_HOURS=12

DJANGO_TIME_ZONE=America/New_York

# Encrypts the saved MySQL credentials. If this is left unset the app keeps a
# private ".credential-key" file beside manage.py instead, which is fine for a
# single server. Either way, back it up: losing it means every saved connection
# has to be entered again.
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# CREDENTIAL_ENCRYPTION_KEY=
